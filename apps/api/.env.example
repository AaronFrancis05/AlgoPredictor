# AlgoPredict API settings (app/core/config.py). Copy to .env and fill in. Never commit .env.
# With ENVIRONMENT=production the API refuses to start unless JWT_SECRET, INGEST_HMAC_SECRET and
# PROXY_SHARED_SECRET are random values of 32+ characters and COOKIE_SECURE=true.
ENVIRONMENT=development
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1","api"]

# Database. Production: DATABASE_URL uses the restricted role (migration b3e7d1a5c9f2):
#   postgresql+asyncpg://algopredict_app.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# and MIGRATION_DATABASE_URL (owner, postgres.<ref>) is set only where `alembic upgrade head` runs.
# DB_SSL must be verify-full in production (checks the server against certs/supabase-prod-ca-2021.crt).
DATABASE_URL=postgresql+asyncpg://algopredict:algopredict@localhost:5432/algopredict
DB_SSL=disable
DB_SSL_ROOT_CERT=certs/supabase-prod-ca-2021.crt
MIGRATION_DATABASE_URL=
DB_TRANSACTION_POOLER=false
# connections per process (API worker / arq worker); keep processes x (size + overflow) under the DB limit
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Redis: rate limits, cache, OAuth state, ingest replay protection, arq worker.
# Local:   redis://localhost:6379/0
# Upstash: rediss://default:<password>@<name>.upstash.io:6379   (TLS; console -> database -> "Connect" -> TCP)
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=5
# arq poll interval. Each poll is one Redis command (billed on Upstash): 10 s ~ 8,640 commands/day.
WORKER_POLL_DELAY_SECONDS=10

# Client IP for rate limits. Same random value as PROXY_SHARED_SECRET in the web app
# (python -c "import secrets; print(secrets.token_urlsafe(32))"). Only requests carrying it may set X-Client-IP.
PROXY_SHARED_SECRET=
# Reverse proxies in front of the API whose X-Forwarded-For entry is trusted (only for direct API traffic,
# e.g. API-key clients through a load balancer). 0 = use the TCP peer address.
TRUSTED_PROXY_COUNT=0

# Rate limits "<count>/<seconds>" (sliding window, per user id or per client IP / IPv6 /64)
RATE_LIMIT_DEFAULT=120/60
RATE_LIMIT_AUTH=5/60
RATE_LIMIT_PRODUCTS=30/60

# Auth
JWT_SECRET=change-me-in-production-at-least-32-bytes!!
COOKIE_SECURE=true
COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Two-factor sign-in. Required in production: a Fernet key that encrypts authenticator secrets. Keep it stable
# (changing it breaks every enrolled authenticator):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
ADMIN_MFA_REQUIRED=true

# Prometheus /metrics: not served unless set (32+ chars), then only with "Authorization: Bearer <token>"
METRICS_TOKEN=

# ML pipeline -> API ingest (HMAC) and web cache revalidation
INGEST_HMAC_SECRET=change-me-ingest-secret
WEB_REVALIDATE_URL=http://web:3000/api/revalidate
WEB_REVALIDATE_SECRET=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Email. Production: Resend's HTTPS API (Railway blocks outbound SMTP on trial/Hobby) - set RESEND_API_KEY
# and a SMTP_FROM on a domain verified in Resend. Without RESEND_API_KEY, mail goes over SMTP (Mailpit locally).
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=AlgoPredict <no-reply@algopredict.local>
# Quota / abuse guards for automatic email (Resend free plan: 100/day, sending paused above 4 % bounces)
EMAIL_DAILY_BUDGET=90
EMAIL_PER_RECIPIENT_PER_HOUR=3
RATE_LIMIT_EMAIL=10/3600
