# AlgoPredict web settings. Copy to .env.local (dev) or pass as container env. Never commit real values.

# --- build time (baked into the build; rebuild to change) ---
# FastAPI address as seen from the web server (rewrite target for /api/v1/* and server-side fetches)
API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- runtime ---
# Same value as PROXY_SHARED_SECRET in the API. Lets the API rate-limit the real visitor, not this server.
PROXY_SHARED_SECRET=
# Load balancers in front of this server that append to X-Forwarded-For (Railway/Render/Fly: 1,
# Cloudflare in front of those: 2). Local `next start` without a proxy: 1.
WEB_TRUSTED_PROXY_COUNT=1
# Shared with the API (WEB_REVALIDATE_SECRET) for on-demand cache revalidation after picks are ingested
REVALIDATE_SECRET=
